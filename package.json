{
  "name": "unfiltered-route-katya-olya-vietnam",
  "version": "0.1.0",
  "private": true,
  "description": "Маршрут без фильтра — playable web adventure prototype",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write src api tests scripts *.ts *.json",
    "format:check": "prettier --check src api tests scripts *.ts *.json"
  },
  "dependencies": {
    "@babylonjs/core": "9.29.0",
    "@fontsource/golos-text": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "idb": "8.0.3",
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sparticuz/chromium": "153.0.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
