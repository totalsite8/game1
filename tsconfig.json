{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@game-core/*": ["src/packages/game-core/*"],
      "@render-babylon/*": ["src/packages/render-babylon/*"],
      "@story/*": ["src/packages/story/*"],
      "@content/*": ["src/packages/content/*"],
      "@platform/*": ["src/packages/platform/*"],
      "@validation/*": ["src/packages/validation/*"],
      "@ui/*": ["src/packages/ui/*"]
    }
  },
  "include": ["src", "api", "scripts"]
}
